# ── Cherry WMS backend environment template ─────────────────────────────
# Copy to .env (gitignored) and fill in. The API refuses to start when
# JWT_SECRET or JWT_REFRESH_SECRET is missing or shorter than 32 chars —
# there is intentionally no built-in fallback, because this repository is
# public and a default secret would let anyone forge an admin token.

# Postgres connection string (the shared deployment DB).
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full
DATABASE_URL=

# Signing secrets. Generate EACH with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use different values for the two, and never reuse them across deployments.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Interface to bind. Default 127.0.0.1 (loopback only). Only set 0.0.0.0 when
# a reverse proxy/firewall in front of this API is part of the deployment.
#HOST=127.0.0.1
#PORT=3001

# Extra browser origins allowed by CORS, comma-separated (localhost:5173 and
# 127.0.0.1:5173 are always allowed).
#EXTRA_CORS_ORIGINS=https://wms.example.com

# GST/HST registration number of the billing entity, snapshotted onto each
# generated bill (CustomerBill.taxRegistrationNo) so invoices carry it. Leave
# unset until the registrant number is known; bills then carry null.
#BILLING_TAX_REG_NO=123456789RT0001
