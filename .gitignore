# ── Repo scope: WMS only (wms-backend + wms-frontend) ──
# Unrelated sibling projects / tooling living in this folder are not part of this repo.
/my-app/
/design-system/
/.agent/
/.shared/

# ── Secrets (never commit) ──
.env
.env.*

# ── Commercial rate cards / pricing data (NEVER COMMIT) ──
# Customer-facing price lists are commercially sensitive. Source workbooks, any
# extract of them, and any seed built from real prices stay out of the repo —
# importer CODE is fine, the DATA is not. Use synthetic prices in tests/fixtures.
*.xlsx
*.xls
*.xlsm
*.csv
**/价卡*
**/rate-card*
**/ratecard*
**/*rate-card*.json
**/*rate-card*.sql
**/seed-rates*

# …but the rate card MODULE is CODE, not prices, and `**/rate-card*` above matches
# its directory name. Without these negations the whole module vanishes from every
# commit — silently, since git never reports files it was told to ignore.
# Git will not descend into an ignored directory, so the directory itself must be
# re-included before its contents can be.
!wms-backend/src/rate-cards/
!wms-backend/src/rate-cards/**
!wms-frontend/src/pages/Settings/RateCard/
!wms-frontend/src/pages/Settings/RateCard/**

# Re-assert the DATA rules after those negations (last matching pattern wins), so
# re-including the module directories cannot become a hole to smuggle a price dump
# through. Source files are .ts; anything below is data and stays blocked everywhere.
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
**/价卡*
**/*rate-card*.json
**/*rate-card*.sql
**/*ratecard*.json
**/*ratecard*.sql
**/seed-rates*

# ── Dependencies & build output ──
node_modules/
dist/
dist-ssr/
.next/
/generated/prisma/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS / editor ──
.DS_Store
.idea/
*.suo
*.sw?
